# System Sense — Database Concurrency mini-series (public demo repo)
#
# NOTE: this deliberately replaces GitHub's stock Python template, which was
# created with the repository. That template ignores *.log, and this repo
# commits capture/*.log on purpose: those logs are the evidence every number in
# the videos is read from. Ignoring them would quietly break the one convention
# the whole channel rests on.

# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
.pytest_cache/

# OS
.DS_Store

# Local env overrides
.env
.env.local

# Captured demo output is committed on purpose (it is the episode's evidence),
# but transient run logs are not.
capture/*.tmp
